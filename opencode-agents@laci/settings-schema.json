{
    "layout": {
        "type": "layout",
        "pages": [
            "page-general",
            "page-discovery",
            "page-panel",
            "page-menu",
            "page-actions"
        ],
        "page-general": {
            "type": "page",
            "title": "General",
            "sections": [
                "section-refresh"
            ]
        },
        "section-refresh": {
            "type": "section",
            "title": "Refresh",
            "keys": [
                "poll-interval",
                "metadata-refresh",
                "max-locations"
            ]
        },
        "page-discovery": {
            "type": "page",
            "title": "Servers",
            "sections": [
                "section-discovery",
                "section-extra"
            ]
        },
        "section-discovery": {
            "type": "section",
            "title": "Discovery",
            "keys": [
                "use-service",
                "service-file",
                "use-proc",
                "discovery-info"
            ]
        },
        "section-extra": {
            "type": "section",
            "title": "Additional servers",
            "keys": [
                "extra-servers",
                "extra-servers-info"
            ]
        },
        "page-panel": {
            "type": "page",
            "title": "Panel",
            "sections": [
                "section-tiles",
                "section-tooltip"
            ]
        },
        "section-tiles": {
            "type": "section",
            "title": "Agent tiles",
            "keys": [
                "tile-show-project",
                "tile-show-subject",
                "tiles-max",
                "animate-tiles",
                "hide-when-idle",
                "tiles-info"
            ]
        },
        "section-tooltip": {
            "type": "section",
            "title": "Tooltip",
            "keys": [
                "tooltip-lines"
            ]
        },
        "page-menu": {
            "type": "page",
            "title": "Menu",
            "sections": [
                "section-menu"
            ]
        },
        "section-menu": {
            "type": "section",
            "title": "Session rows",
            "keys": [
                "menu-title-length",
                "menu-show-model",
                "menu-show-directory",
                "menu-show-cost",
                "menu-show-idle-servers"
            ]
        },
        "page-actions": {
            "type": "page",
            "title": "Actions",
            "sections": [
                "section-actions"
            ]
        },
        "section-actions": {
            "type": "section",
            "title": "Session actions",
            "keys": [
                "click-action",
                "click-command",
                "click-command-info"
            ]
        }
    },
    "poll-interval": {
        "type": "spinbutton",
        "default": 2,
        "min": 1,
        "max": 60,
        "step": 1,
        "units": "s",
        "description": "Poll interval",
        "tooltip": "How often every opencode server is asked which agents are working."
    },
    "metadata-refresh": {
        "type": "spinbutton",
        "default": 30,
        "min": 5,
        "max": 600,
        "step": 5,
        "units": "s",
        "description": "Session details refresh",
        "tooltip": "How long the title/agent/model of a session and the project list are cached before being fetched again."
    },
    "max-locations": {
        "type": "spinbutton",
        "default": 12,
        "min": 1,
        "max": 200,
        "step": 4,
        "units": "projects",
        "description": "Projects checked for pending requests",
        "tooltip": "A permission request or question exists only inside the project that raised it, so the loaded projects are swept for one. This bounds that sweep."
    },
    "use-service": {
        "type": "switch",
        "default": true,
        "description": "Read the opencode service file",
        "tooltip": "Uses the file the shared server writes when it starts, which carries its url and password."
    },
    "service-file": {
        "type": "entry",
        "default": "",
        "description": "Service file",
        "dependency": "use-service",
        "tooltip": "Leave empty for ~/.local/state/opencode/service.json"
    },
    "use-proc": {
        "type": "switch",
        "default": true,
        "description": "Scan for running opencode servers",
        "tooltip": "Finds every 'opencode serve' process of this user and reads its port, for a server started by hand on its own port and never registered."
    },
    "discovery-info": {
        "type": "label",
        "description": "opencode v2 runs one shared background server for every project, and registers it in the service file. This applet reads that registration, so normally one server is all it needs."
    },
    "extra-servers": {
        "type": "textview",
        "default": "",
        "height": 120,
        "description": "Additional servers",
        "tooltip": "One per line: host:port or host:port:username:password"
    },
    "extra-servers-info": {
        "type": "label",
        "description": "Useful for a server on another machine or one whose port is fixed in a script."
    },
    "tooltip-lines": {
        "type": "spinbutton",
        "default": 6,
        "min": 0,
        "max": 20,
        "step": 1,
        "units": "sessions",
        "description": "Sessions listed in the tooltip"
    },
    "menu-title-length": {
        "type": "spinbutton",
        "default": 48,
        "min": 16,
        "max": 120,
        "step": 4,
        "units": "characters",
        "description": "Session title length"
    },
    "menu-show-model": {
        "type": "switch",
        "default": true,
        "description": "Show the model in session rows"
    },
    "menu-show-directory": {
        "type": "switch",
        "default": true,
        "description": "Show the project directory in session details"
    },
    "menu-show-cost": {
        "type": "switch",
        "default": false,
        "description": "Show cost and token usage in session details"
    },
    "menu-show-idle-servers": {
        "type": "switch",
        "default": true,
        "description": "List servers without active sessions"
    },
    "click-action": {
        "type": "combobox",
        "default": "copy",
        "description": "Action for a session",
        "options": {
            "Copy the session ID": "copy",
            "Run a command": "command",
            "Do nothing": "none"
        }
    },
    "click-command": {
        "type": "entry",
        "default": "x-terminal-emulator -e opencode --session {id}",
        "dependency": "click-action=command",
        "description": "Command",
        "tooltip": "Placeholders: {id}, {title}, {project}, {dir}, {agent}, {model}, {status}"
    },
    "click-command-info": {
        "type": "label",
        "description": "The command runs from the applet when you use 'Run command for this session' in a session's submenu."
    },
    "tile-show-project": {
        "type": "switch",
        "default": true,
        "description": "Show the project on the top line"
    },
    "tile-show-subject": {
        "type": "switch",
        "default": true,
        "description": "Show the conversation subject on the bottom line"
    },
    "tiles-max": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 20,
        "step": 1,
        "units": "agents",
        "description": "Agents shown side by side",
        "tooltip": "Further active agents are counted in a +N tile."
    },
    "hide-when-idle": {
        "type": "switch",
        "default": false,
        "description": "Hide the panel icon when no agent is working"
    },
    "animate-tiles": {
        "type": "switch",
        "default": true,
        "description": "Animate new and finished agents",
        "tooltip": "A session that starts slides in from the left; one that leaves slides out. While an agent works, a thin bar sweeps along the top edge of its tile. When a tile turns red or green, a frame in that colour closes in from the screen border to the tile. Turn off for instant changes, a steady bar and no screen-border frame."
    },
    "tiles-info": {
        "type": "label",
        "description": "Every agent gets a tile: the project over the conversation subject, with a thin amber bar along its top edge that sweeps while the agent works. The colours follow the opencode project studio: a blocked tile (the agent waits for you) fills red, an unread finish fills green, and a working one keeps the panel background. Clicking a green tile acknowledges it, and it slides away. The menu lists every session with its project, agent, model and status. The applet never shows desktop notifications."
    }
}
